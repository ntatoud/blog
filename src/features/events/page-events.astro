---
import { getUiState } from '@bearstudio/ui-state';

import { HighlightedText } from '@/components/ui/highlighted-text';

import EventCard from './event-card.astro';
import { getEventCollection } from './events';

const events = await getEventCollection({ limit: 20 });

const ui = getUiState((set) => {
  if (!events.length) return set('empty');

  return set('default');
});
---

<div class="flex w-full items-center justify-center py-24 text-center lg:pt-32">
  <h1 class="font-head text-3xl font-bold tracking-tight lg:text-4xl">
    List of <HighlightedText>Events</HighlightedText> I go to
  </h1>
</div>
<section>
  {
    ui
      .match('empty', () => {
        return (
          <div class="text-muted-foreground my-10 flex w-full flex-col items-center gap-4">
            I have not participated in events yet!
          </div>
        );
      })
      .match('default', () => {
        return (
          <ul class="flex h-fit flex-col justify-center gap-4 md:flex-row md:flex-wrap">
            {events.map((event) => (
              <li class="md:w-[calc(50%-0.5rem)]">
                <EventCard event={event.data} />
              </li>
            ))}
          </ul>
        );
      })
      .exhaustive()
  }
</section>
